+def runtime_snapshot(python):
+    code = 'import sys,json,importlib.metadata as m;print(json.dumps({"python":sys.version,"executable":sys.executable,"prefix":sys.prefix,"packages":{n:m.version(n) for n in '+repr(PACKAGES)+'}}))'
+    env = os.environ.copy()
