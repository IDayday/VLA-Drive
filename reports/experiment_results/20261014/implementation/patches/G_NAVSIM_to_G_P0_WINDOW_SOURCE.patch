+def acquire(stack, path):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    stream = stack.enter_context(path.open('a'))
+    fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    return stream
