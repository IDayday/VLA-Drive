+def authorize(host):
+    policy = read(POLICY)
+    require(host in policy['task_authorizations'][TASK]['allowed_hosts'], 'Current task policy rejects host')
+    return {'path': str(POLICY), 'sha256': digest(POLICY), 'task_authorization': policy['task_authorizations'][TASK]}
