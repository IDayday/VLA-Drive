          "patch": "--- Qwen3VLVisionAttention/original\n+++ Qwen3VLVisionAttention/instance_adapter\n@@ -6,6 +6,7 @@\n     position_embeddings: Optional[tuple[torch.Tensor, torch.Tensor]] = None,\n     **kwargs,\n ) -> torch.Tensor:\n+    lengths_cpu = kwargs.pop('_structured_world_lengths_cpu', None)\n     seq_length = hidden_states.shape[0]\n     query_states, key_states, value_states = (\n         self.qkv(hidden_states).reshape(seq_length, 3, self.num_heads, -1).permute(1, 0, 2, 3).unbind(0)\n@@ -41,9 +42,10 @@\n         )\n     else:\n         # Other implementations: Process each chunk separately\n-        lengths = cu_seqlens[1:] - cu_seqlens[:-1]\n+        if lengths_cpu is None:\n+            lengths_cpu = _structured_world_make_lengths_cpu(cu_seqlens)\n         splits = [\n-            torch.split(tensor, lengths.tolist(), dim=2) for tensor in (query_states, key_states, value_states)\n+            torch.split(tensor, lengths_cpu, dim=2) for tensor in (query_states, key_states, value_states)\n         ]\n \n         attn_outputs = [\n",
