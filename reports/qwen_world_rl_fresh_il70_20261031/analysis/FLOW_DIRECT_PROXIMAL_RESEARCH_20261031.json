  "paper_claims": [
    {
      "claim": "在图像flow-RL上，以Gaussian conditional KL门槛加非对称方向mask替换PPO ratio clip，报告更稳的多轮复用与图像reward/保持表现。",
      "source": "https://arxiv.org/html/2606.11025v2",
      "location": "Sec3.3 Eq14/17/18,Sec4",
      "scope": "image generation,not driving PDMS"
    },
    {
      "claim": "v2 AppendixE明确ratio方向只是KL变化方向的启发式；预测mask尚待实证，未被当作已验证主算法。",
      "source": "https://arxiv.org/html/2606.11025v2",
      "location": "AppendixE.1-E.3"
    }
  ],
  "official_implementation_findings": [
    {
      "finding": "flowdppo_kl_adv_loss仍优化-A*exp(new_logp-old_logp)，仅mask阈值改成Gaussian旧新均值位移；ratio方向未消失。",
      "source": "https://github.com/Tencent-Hunyuan/UniRL/blob/main/unirl/algorithms/flowdppo.py"
    },
    {
      "finding": "gaussian元素KL对latent轴取mean；kl_mask_threshold单位是每坐标KL。代码边界>=delta屏蔽，论文写>delta。",
      "source": "https://github.com/Tencent-Hunyuan/UniRL/blob/main/unirl/algorithms/flowdppo.py"
    },
    {
      "finding": "SDE finalize_logp同样对latent轴取mean，因此当前官方工程ratio也不是完整latent联合密度比。",
      "source": "https://github.com/Tencent-Hunyuan/UniRL/blob/main/unirl/sde/kernels.py"
    },
    {
      "finding": "当前config extract threshold1e-5，paperF.2报告FlowSDE1e-7/CPS1e-6；不同归约/实现与采样不能照搬阈值。",
      "source": "https://github.com/Tencent-Hunyuan/UniRL/blob/main/FlowDPPO/config.yaml",
      "paper_source": "https://arxiv.org/html/2606.11025v2"
    }
  ],
